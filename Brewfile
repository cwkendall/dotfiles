# OpenCode's official Homebrew tap; required for the model-agnostic coding agent below.
tap "anomalyco/tap"

# Bun's official tap; provides current releases faster than the core formula.
tap "oven-sh/bun"

# Git is the source-control foundation and is kept newer than Apple's bundled copy.
brew "git"

# GitHub CLI handles repository authentication, issues, pull requests and releases.
brew "gh"

# LazyGit provides an interactive terminal UI for reviewing and staging changes.
brew "lazygit"

# jq queries and transforms JSON returned by APIs and command-line tools.
brew "jq"

# yq is jq's counterpart for YAML configuration and infrastructure files.
brew "yq"

# ripgrep (`rg`) is a very fast recursive text and source-code search tool.
brew "ripgrep"

# ast-grep searches and rewrites source code by syntax rather than fragile text patterns.
brew "ast-grep"

# fzf adds fuzzy file, command-history and completion selection to the shell.
brew "fzf"

# uv manages Python versions, projects and isolated command-line tools quickly.
brew "uv"

# Bun is the preferred JavaScript/TypeScript runtime, package manager and test runner.
brew "oven-sh/bun/bun", trusted: true

# Starship provides a fast, cross-shell prompt without requiring a zsh framework.
brew "starship"

# bat is a syntax-highlighted, Git-aware replacement for displaying text files.
brew "bat"

# eza is a modern, Git-aware directory listing while leaving the standard `ls` intact.
brew "eza"

# fd is a concise, fast and ignore-aware alternative to `find` for interactive use.
brew "fd"

# zoxide learns visited directories so `z name` can jump to them quickly.
brew "zoxide"

# Delta renders readable syntax-highlighted Git diffs and is configured by gitconfig.
brew "git-delta"

# direnv loads reviewed, project-local environment variables on directory entry.
brew "direnv"

# just runs memorable project recipes such as `just test` from a justfile.
brew "just"

# OpenCode is the default open-source, multi-provider terminal coding agent.
brew "anomalyco/tap/opencode", trusted: true

# Ghostty is a fast native terminal with deliberately minimal tracked configuration.
cask "ghostty"

# Zed is a fast native editor with built-in collaboration and agent support.
cask "zed"

# JetBrains Mono Nerd Font supplies programming ligatures and prompt/icon glyphs.
cask "font-jetbrains-mono-nerd-font"
